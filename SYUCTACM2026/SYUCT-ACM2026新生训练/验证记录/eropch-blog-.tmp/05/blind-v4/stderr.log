  #include <bits/stdc++.h>
  using namespace std;

  int main() {
      ios::sync_with_stdio(false);
      cin.tie(nullptr);

      string s;
      if (!(cin >> s)) return 0;
      if (s.size() >= 3 && (unsigned char)s[0] == 0xEF &&
