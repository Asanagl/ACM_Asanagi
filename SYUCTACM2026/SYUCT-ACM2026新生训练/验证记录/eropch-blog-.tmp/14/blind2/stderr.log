  Now the C++17 program.

  ```cpp
  #include <iostream>
  #include <vector>

  int main() {
      std::ios::sync_with_stdio(false);
      std::cin.tie(nullptr);

      int n, m;
      if (!(std::cin >> n >> m)) return 0;

      std::vector<long long> col(m, 0);
      for (int i = 0; i < n; ++i) {
          for (int j = 0; j < m; ++j) {
              long long x;
              std::cin >> x;
              col[j] += x;
          }
      }

      for (int j = 0; j < m; ++j) {
          if (j) std::cout << ' ';
          std::cout << col[j];
      }
      std::cout << '\n';
      return 0;
  }
  ```

