  ```cpp
  #include <cstdio>
  #include <cstdlib>
  #include <vector>

  namespace io {
      const int BUFSZ = 1 << 16;
      char inbuf[BUFSZ];
      int inpos = 0, inlen = 0;

      inline int gc() {
          if (inpos == inlen) {
              inlen = (int)fread(inbuf, 1, BUFSZ, stdin);
              inpos = 0;
              if (inlen <= 0) return -1;
          }
          return (unsigned char)inbuf[inpos++];
      }

      bool readInt(long long &out) {
          int c = gc();
          while (c != -1 && (c < '0' || c > '9') && c != '-') c = gc();
          if (c == -1) return false;
          bool neg = false;
          if (c == '-') { neg = true; c = gc(); }
          long long v = 0;
          while (c >= '0' && c <= '9') { v = v * 10 + (c - '0'); c = gc(); }
          out = neg ? -v : v;
          return true;
      }

      char outbuf[BUFSZ];
      int outpos = 0;

      inline void flushOut() { fwrite(outbuf, 1, outpos, stdout); outpos = 0; }

      inline void putChar(char ch) { if (outpos == BUFSZ) flushOut(); outbuf[outpos++] = ch; }

      void writeInt(long long v) {
          if (v == 0) { putChar('0'); return; }
          if (v < 0) { putChar('-'); v = -v; }
          char tmp[24]; int t = 0;
          while (v > 0) { tmp[t++] = char('0' + v % 10); v /= 10; }
          while (t > 0) putChar(tmp[--t]);
      }
  }
  ```

