  Let me write the C++17 program:

  ```cpp
  #include <bits/stdc++.h>
  using namespace std;

  int main() {
      ios::sync_with_stdio(false);
      cin.tie(nullptr);

      int n, m;
      if (!(cin >> n >> m)) return 0;

      vector<vector<int>> a(n, vector<int>(m));
      for (int i = 0; i < n; ++i)
          for (int j = 0; j < m; ++j)
              cin >> a[i][j];

      for (int i = 0; i < n; ++i) {
          for (int j = m - 1; j >= 0; --j) {
              if (j != m - 1) cout << ' ';
              cout << a[i][j];
          }
          cout << '\n';
      }
      return 0;
  }
  ```

  `<bits/stdc++.h>` is GCC-specific; to be safe use <iostream>, <vector>. Better portable.

