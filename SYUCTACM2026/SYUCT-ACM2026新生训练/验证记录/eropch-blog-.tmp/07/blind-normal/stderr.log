  ```cpp
  #include <iostream>
  #include <string>

  int main() {
      std::ios::sync_with_stdio(false);
      std::cin.tie(nullptr);

      std::string s;
      if (!(std::cin >> s)) return 0;

      const int n = static_cast<int>(s.size());
      int l = 0, r = n - 1;
      bool ok = true;
      while (l < r) {
          if (s[l] != s[r]) { ok = false; break; }
          ++l;
          --r;
      }
      std::cout << (ok ? "YES" : "NO") << '\n';
      return 0;
  }
  ```

