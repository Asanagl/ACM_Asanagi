  Let me write the code.

  ```cpp
  #include <cstdio>
  #include <vector>

  int main() {
      int n, m, q;
      if (std::scanf("%d %d %d", &n, &m, &q) != 3) return 0;
      std::vector<std::vector<long long>> pre(n + 1, std::vector<long long>(m + 1, 0));
      for (int i = 1; i <= n; ++i) {
          for (int j = 1; j <= m; ++j) {
              long long x;
              std::scanf("%lld", &x);
              pre[i][j] = x + pre[i - 1][j] + pre[i][j - 1] - pre[i - 1][j - 1];
          }
      }
      for (int k = 0; k < q; ++k) {
          int r1, c1, r2, c2;
          std::scanf("%d %d %d %d", &r1, &c1, &r2, &c2);
          long long ans = pre[r2][c2] - pre[r1 - 1][c2] - pre[r2][c1 - 1] + pre[r1 - 1][c1 - 1];
          std::printf("%lld\n", ans);
      }
      return 0;
  }
  ```

