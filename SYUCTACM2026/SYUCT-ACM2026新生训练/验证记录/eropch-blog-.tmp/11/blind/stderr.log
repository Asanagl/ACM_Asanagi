  Implementation:

  ```cpp
  #include <iostream>

  int main() {
      std::ios::sync_with_stdio(false);
      std::cin.tie(nullptr);

      int n = 0, m = 0;
      if (!(std::cin >> n >> m)) return 0;

      for (int i = 0; i < n; ++i) {
          for (int j = 0; j < m; ++j) {
              int a = 0;
              std::cin >> a;
              if (j > 0) std::cout << ' ';
              std::cout << a;
          }
          std::cout << '\n';
      }
      return 0;
  }
  ```

