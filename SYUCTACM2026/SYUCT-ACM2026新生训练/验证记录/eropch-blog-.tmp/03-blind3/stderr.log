  #include <cstdio>
  #include <iostream>
  #include <string>

  int main() {
      std::ios::sync_with_stdio(false);
      std::cin.tie(nullptr);

      std::string s;
      if (!std::cin >> s) return 0;

      long long cnt[5] = {0, 0, 0, 0, 0};
      for (char ch : s) {
          char c = static_cast<char>(ch | 0x20);
          switch (c) {
              case 'a': ++cnt[0]; break;
              case 'e': ++cnt[1]; break;
              case 'i': ++cnt[2]; break;
              case 'o': ++cnt[3]; break;
              case 'u': ++cnt[4]; break;
              default: break;
          }
      }

      for (int k = 0; k < 5; ++k) {
          if (k) std::cout << ' ';
          std::cout << cnt[k];
      }
      std::cout << '\n';
      return 0;
  }
  ```

