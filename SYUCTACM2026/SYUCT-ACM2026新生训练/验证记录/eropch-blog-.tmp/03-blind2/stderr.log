  Implementation:

  ```cpp
  #include <cstdio>
  #include <cstring>

  namespace {
  constexpr std::size_t BUFSZ = 1u << 16;
  char buf[BUFSZ];
  }

  int main() {
      int cnt[5] = {0,0,0,0,0};
      std::size_t len;
      bool any = false;
      while ((len = std::fread(buf, 1, BUFSZ, stdin)) > 0) {
          for (std::size_t k = 0; k < len; ++k) {
              char c = buf[k];
              if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
              switch (c) {
                  case 'a': ++cnt[0]; break;
                  case 'e': ++cnt[1]; break;
                  case 'i': ++cnt[2]; break;
                  case 'o': ++cnt[3]; break;
                  case 'u': ++cnt[4]; break;
                  default: break;
              }
          }
      }
      std::printf("%d %d %d %d %d\n", cnt[0], cnt[1], cnt[2], cnt[3], cnt[4]);
      return 0;
  }
  ```

  This handles no trailing newline and arbitrary whitespace (there is none besides possibly newline). Counts fit in int (max 1e6).

