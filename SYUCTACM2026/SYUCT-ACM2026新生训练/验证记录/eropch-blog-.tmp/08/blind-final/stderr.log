  #include <iostream>
  #include <string>
  #include <vector>

  int main() {
      std::ios::sync_with_stdio(false);
      std::cin.tie(nullptr);

      std::string s, t;
      if (!(std::cin >> s)) return 0;
      if (!(std::cin >> t)) {
          std::cout << -1 << '\n';
          return 0;
      }

      const int n = static_cast<int>(s.size());
      const int m = static_cast<int>(t.size());

      if (m == 0) { std::cout << 0 << '\n'; return 0; }
      if (m > n) { std::cout << -1 << '\n'; return 0; }

      std::vector<int> pi(m, 0);
      for (int i = 1; i < m; ++i) {
          int k = pi[i - 1];
          while (k > 0 && t[i] != t[k]) k = pi[k - 1];
          if (t[i] == t[k]) ++k;
          pi[i] = k;
      }

      int j = 0;
      for (int i = 0; i < n; ++i) {
          while (j > 0 && s[i] != t[j]) j = pi[j - 1];
          if (s[i] == t[j]) ++j;
          if (j == m) {
              std::cout << (i - m + 1) << '\n';
              return 0;
          }
      }

      std::cout << -1 << '\n';
      return 0;
  }
  ```

